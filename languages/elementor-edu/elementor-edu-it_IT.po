msgstr "Project-Id-Version: Elementor Edu\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nLanguage: it_IT\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Elementor in one package for educational and demonstration use."
msgstr "Elementor in un unico pacchetto per uso educativo e dimostrativo."

msgid "Deactivate the separate Elementor and Elementor Pro plugins before activating Elementor Edu. Existing content will be preserved."
msgstr "Disattiva Elementor ed Elementor Pro separati prima di attivare Elementor Edu. I contenuti esistenti vengono conservati."

msgid "The Elementor Edu package is incomplete. Reinstall the complete ZIP file."
msgstr "Il pacchetto Elementor Edu è incompleto. Reinstalla lo ZIP completo."

msgid "Deactivate the separate Elementor and Elementor Pro plugins on every site before activating Elementor Edu across the network."
msgstr "Disattiva Elementor ed Elementor Pro separati in tutti i siti della rete prima di attivare Elementor Edu nella rete."

msgid "Updates are unavailable for this copy"
msgstr "Aggiornamenti di questa copia non disponibili"

msgid "To change versions, upload a complete Elementor Edu package. Rolling back individual components is unavailable."
msgstr "Per cambiare versione carica un pacchetto completo Elementor Edu. Il ripristino dei singoli motori non è disponibile."

msgid "Complete your setup with Hello Elementor"
msgstr "Completa la configurazione con Hello Elementor"

msgid "Each site in the network has its own theme. Open the site dashboard to configure it."
msgstr "Il tema viene scelto per ogni sito della rete. Apri l’amministrazione del sito per configurarlo."

msgid "Set up this site's theme"
msgstr "Configura il tema di questo sito"

msgid "Ask an authorized administrator to install Hello Elementor. You can then activate it here."
msgstr "Chiedi a un amministratore autorizzato di installare Hello Elementor; poi potrai attivarlo qui."

msgid "Ask the network administrator to enable Hello Elementor for this site."
msgstr "Chiedi all’amministratore della rete di abilitare Hello Elementor per questo sito."

msgid "Activating the theme will change the appearance of your site. Your previous theme and content will be preserved."
msgstr "L’attivazione cambierà l’aspetto del sito. Il tema precedente e i contenuti saranno conservati."

msgid "Use the Hello Elementor installation button."
msgstr "Usa il pulsante di installazione di Hello Elementor."

msgid "You do not have permission to change this site's theme."
msgstr "Non hai i permessi per cambiare il tema di questo sito."

msgid "Hello Elementor setup"
msgstr "Configurazione di Hello Elementor"

msgid "You do not have permission to change the theme."
msgstr "Non hai i permessi per cambiare il tema."

msgid "You do not have permission to install themes."
msgstr "Non hai i permessi per installare temi."

msgid "The Hello Elementor package is unavailable. Reinstall the complete Elementor Edu ZIP file."
msgstr "Il pacchetto Hello Elementor non è disponibile. Reinstalla lo ZIP completo di Elementor Edu."

msgid "Hello Elementor is incomplete or invalid. Restore it from Appearance > Themes and try again."
msgstr "Hello Elementor risulta incompleto o non valido. Ripristina il tema dalla pagina Aspetto > Temi e riprova."

msgid "The network administrator must enable Hello Elementor for this site."
msgstr "L’amministratore della rete deve abilitare Hello Elementor per questo sito."

msgid "Hello Elementor is installed but could not be activated. Try again from Appearance > Themes."
msgstr "Hello Elementor è installato, ma non è stato possibile attivarlo. Riprova da Aspetto > Temi."

msgid "Could not save the Elementor Edu educational settings. Check the WordPress database."
msgstr "Impossibile salvare la configurazione didattica di Elementor Edu. Verifica il database di WordPress."

msgid "Could not set up educational notices: an incompatible file exists at mu-plugins/elementor-edu-course.php."
msgstr "Impossibile predisporre gli avvisi didattici: esiste un file incompatibile in mu-plugins/elementor-edu-course.php."

msgid "Elementor Edu needs write access to the WordPress mu-plugins directory to maintain educational notices."
msgstr "Elementor Edu richiede che la cartella mu-plugins di WordPress sia scrivibile per mantenere gli avvisi didattici."

msgid "Could not set up Elementor Edu educational notices. Check the mu-plugins directory permissions."
msgstr "Impossibile predisporre gli avvisi didattici di Elementor Edu. Verifica i permessi della cartella mu-plugins."

msgid "Could not save Elementor Edu educational notices. Check the mu-plugins directory permissions."
msgstr "Impossibile salvare gli avvisi didattici di Elementor Edu. Verifica i permessi della cartella mu-plugins."

msgid "An Elementor update is available"
msgstr "Aggiornamento Elementor disponibile"

msgid "A new version of Elementor is available. You can install it now."
msgstr "È disponibile una nuova versione di Elementor. Puoi installarla ora."

msgid "Update Elementor now"
msgstr "Aggiorna Elementor ora"

msgid "Later"
msgstr "Più tardi"

msgid "You do not have permission to update plugins."
msgstr "Non hai i permessi per aggiornare i plugin."

msgid "Use the Elementor update button."
msgstr "Usa il pulsante di aggiornamento di Elementor."

msgid "No Elementor update is available."
msgstr "Non è disponibile un aggiornamento di Elementor."

msgid "Could not prepare the Elementor update. Please try again later."
msgstr "Non è stato possibile preparare l’aggiornamento di Elementor. Riprova più tardi."

msgid "Elementor update"
msgstr "Aggiornamento Elementor"

msgid "The prepared Elementor package is no longer available."
msgstr "Il pacchetto Elementor preparato non è più disponibile."

msgid "Could not prepare the Elementor package for installation."
msgstr "Impossibile preparare il pacchetto Elementor per l’installazione."

msgid "Updates for this educational copy of Elementor are no longer available. Switch to the official version of Elementor Pro to keep receiving updates."
msgstr "Gli aggiornamenti di questa copia didattica di Elementor non sono più disponibili. Passa alla versione ufficiale di Elementor Pro per continuare a riceverli."

msgid "The server does not have the ZIP support required to prepare the Elementor update."
msgstr "Il server non dispone del supporto ZIP richiesto per preparare l’aggiornamento Elementor."

msgid "The available version changed during preparation. Reload the dashboard and try again."
msgstr "La versione disponibile è cambiata durante la preparazione. Ricarica la bacheca e riprova."

msgid "Could not verify the Elementor package."
msgstr "Impossibile verificare il pacchetto Elementor."

msgid "The source returned an Elementor version older than the installed version."
msgstr "La fonte ha restituito una versione di Elementor precedente a quella installata."

msgid "Could not create the temporary update directory."
msgstr "Impossibile creare l’area temporanea di aggiornamento."

msgid "Could not access the temporary directory to prepare the Elementor update."
msgstr "Impossibile accedere all’area temporanea per preparare l’aggiornamento di Elementor."

msgid "This site does not meet the requirements of the new Elementor version."
msgstr "Il sito non soddisfa i requisiti della nuova versione di Elementor."

msgid "Could not prepare a complete copy of the plugin."
msgstr "Impossibile preparare la copia completa del plugin."

msgid "The downloaded package structure is invalid."
msgstr "La struttura del pacchetto scaricato non è valida."

msgid "Could not integrate the new version's files."
msgstr "Impossibile integrare i file della nuova versione."

msgid "The installed package manifest is invalid."
msgstr "Il manifest del pacchetto installato non è valido."

msgid "Could not create the update package."
msgstr "Impossibile creare il pacchetto di aggiornamento."

msgid "Could not complete the update package."
msgstr "Impossibile completare il pacchetto di aggiornamento."

msgid "Could not read the available version."
msgstr "Impossibile leggere la versione disponibile."

msgid "Could not find the plugin to download."
msgstr "Non ho trovato il plugin da scaricare."

msgid "The downloaded package is not a valid ZIP archive."
msgstr "Il pacchetto scaricato non è un archivio ZIP valido."

msgid "The package contains a disallowed symbolic link."
msgstr "Il pacchetto contiene un collegamento simbolico non consentito."

msgid "The package contains duplicate paths."
msgstr "Il pacchetto contiene percorsi duplicati."

msgid "The package contains a disallowed path."
msgstr "Il pacchetto contiene un percorso non consentito."

msgid "The package exceeds the maximum allowed size."
msgstr "Il pacchetto supera la dimensione massima consentita."

msgid "The package does not contain the expected files."
msgstr "Il pacchetto non contiene i file attesi."

msgid "The package version does not match the detected version."
msgstr "La versione del pacchetto non corrisponde a quella rilevata."

msgid "The package header version does not match its runtime version."
msgstr "La versione dichiarata nel pacchetto non coincide con il suo runtime."

msgid "Could not read the Elementor package requirements."
msgstr "Impossibile leggere i requisiti del pacchetto Elementor."

msgid "The Elementor package does not declare its minimum requirements."
msgstr "Il pacchetto Elementor non dichiara i requisiti minimi."

msgid "The downloaded package is incompatible with Elementor Edu."
msgstr "Il pacchetto scaricato non è compatibile con Elementor Edu."

msgid "The downloaded package needs to be adapted before installation."
msgstr "Il pacchetto scaricato richiede un adattamento prima dell’installazione."

msgid "The update source must use HTTPS."
msgstr "La fonte degli aggiornamenti deve usare HTTPS."

msgid "The source redirected to a disallowed host or protocol."
msgstr "La fonte ha reindirizzato a un host o protocollo non consentito."

msgid "The update source is unreachable."
msgstr "La fonte degli aggiornamenti non è raggiungibile."

msgid "The source exceeded the allowed number of redirects."
msgstr "La fonte ha superato il numero di reindirizzamenti consentito."

msgid "The downloaded package has an invalid size."
msgstr "Il pacchetto scaricato ha una dimensione non valida."

msgid "Could not save the package temporarily."
msgstr "Impossibile salvare temporaneamente il pacchetto."

msgid "Elementor: educational use only."
msgstr "Elementor: copia a uso puramente didattico."

msgid "This copy will keep working, but its update period has ended. Elementor updates will no longer be checked for or installed through this copy."
msgstr "Questa copia continua a funzionare, ma il periodo previsto per ricevere gli aggiornamenti è terminato. Da questo momento non vengono più cercati né installati aggiornamenti di Elementor tramite questa copia."

msgid "Please deactivate this copy and replace it with an official installation of %s. Switch to the official version of Elementor Pro to keep receiving Elementor updates."
msgstr "Ti invitiamo a disattivarla e a sostituirla con un’installazione regolare di %s. Per continuare a ricevere gli aggiornamenti di Elementor, passa alla versione ufficiale di Elementor Pro."

msgid "Elementor Pro from the official website"
msgstr "Elementor Pro dal sito ufficiale"

msgid "Elementor Edu – Educational use only."
msgstr "Elementor Edu – Utilizzo esclusivamente educativo."

msgid "This plugin is intended only for course demonstrations and exercises. It must not be used outside activities directly related to the course."
msgstr "Questo plugin è destinato esclusivamente alle dimostrazioni e alle esercitazioni del corso. Non deve in nessun caso essere utilizzato al di fuori delle attività strettamente legate al corso."

msgid "Elementor Edu requires PHP %s or later."
msgstr "Elementor Edu richiede PHP %s o successivo."

msgid "Elementor Edu requires WordPress %s or later."
msgstr "Elementor Edu richiede WordPress %s o successivo."

msgid "The translation catalogue is invalid. Existing translations have been kept."
msgstr "Il catalogo di traduzione non è valido. Le traduzioni esistenti sono state conservate."

msgid "Could not save translations. Existing translations have been kept."
msgstr "Impossibile salvare le traduzioni. Le traduzioni esistenti sono state conservate."

msgid "A translation source is unavailable. Existing translations have been kept; another attempt is scheduled."
msgstr "Una fonte delle traduzioni non è disponibile. Le traduzioni esistenti sono state conservate; è previsto un nuovo tentativo."

msgid "Elementor Edu – Educational notice"
msgstr "Elementor Edu – Avviso educativo"

msgid "Maintains educational notices and usage conditions for Elementor Edu."
msgstr "Mantiene gli avvisi e le condizioni di utilizzo didattico di Elementor Edu."

msgid "Updates managed by the plugin itself"
msgstr "Aggiornamenti gestiti dal plugin stesso"

msgid "Install and activate Hello Elementor to complete your setup and continue to the dashboard."
msgstr "Installa e attiva Hello Elementor per completare la configurazione e proseguire alla Bacheca."

msgid "Install the Hello Elementor theme"
msgstr "Installa il tema Hello Elementor"

