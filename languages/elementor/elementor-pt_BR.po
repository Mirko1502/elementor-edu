msgstr "Abra as configurações da página e defina uma imagem destacada."

#: assets/js/packages/editor-audits/editor-audits.js:2385
#: assets/js/packages/editor-audits/editor-audits.strings.js:74
msgid "Featured images are used by social shares and many themes for hero visuals."
msgstr "As imagens destacadas são usadas em compartilhamentos nas redes sociais, e muitos temas as usam como elementos visuais em destaque."

#: assets/js/packages/editor-audits/editor-audits.js:2384
#: assets/js/packages/editor-audits/editor-audits.strings.js:73
msgid "Page featured image"
msgstr "Imagem destacada da página"

#: assets/js/packages/editor-audits/editor-audits.js:2372
#: assets/js/packages/editor-audits/editor-audits.strings.js:72
msgid "Page has no excerpt."
msgstr "A página não tem resumo."

#: assets/js/packages/editor-audits/editor-audits.js:2362
#: assets/js/packages/editor-audits/editor-audits.strings.js:71
msgid "Open Page Settings and write a short excerpt."
msgstr "Abra as configurações da página e escreva um pequeno resumo."

#: assets/js/packages/editor-audits/editor-audits.js:2361
#: assets/js/packages/editor-audits/editor-audits.strings.js:70
msgid "A descriptive excerpt helps search engines and previews summarize the page."
msgstr "Um resumo descritivo ajuda os mecanismos de pesquisa e as pré-visualizações a resumir o conteúdo da página."

#: assets/js/packages/editor-audits/editor-audits.js:2360
#: assets/js/packages/editor-audits/editor-audits.strings.js:69
msgid "Page excerpt"
msgstr "Resumo da página"

#: assets/js/packages/editor-audits/editor-audits.js:2346
#: assets/js/packages/editor-audits/editor-audits.strings.js:68
msgid "Nested boxed container."
msgstr "Contêiner encaixotado aninhado."

#: assets/js/packages/editor-audits/editor-audits.js:2329
#: assets/js/packages/editor-audits/editor-audits.strings.js:66
msgid "Change the inner container's content width to Full Width."
msgstr "Altere a largura do conteúdo do contêiner interno para “Largura total”."

#: assets/js/packages/editor-audits/editor-audits.js:2328
#: assets/js/packages/editor-audits/editor-audits.strings.js:65
msgid "An inner container does not need to be boxed when its parent already is."
msgstr "Não é necessário encaixotar um contêiner interno, quando seu contêiner principal já está encaixotado."

#: assets/js/packages/editor-audits/editor-audits.js:2327
#: assets/js/packages/editor-audits/editor-audits.strings.js:64
msgid "Boxed container nested inside a boxed parent"
msgstr "Contêiner encaixotado aninhado dentro de um contêiner principal encaixotado"

#. translators: %d is the image file size in kilobytes.
#: assets/js/packages/editor-audits/editor-audits.js:2309
#: assets/js/packages/editor-audits/editor-audits.strings.js:63
msgid "Image is %d KB (over 500 KB)."
msgstr "A imagem tem %d KB (mais de 500 KB)."

#: assets/js/packages/editor-audits/editor-audits.js:2284
#: assets/js/packages/editor-audits/editor-audits.strings.js:60
msgid "Replace the image with a smaller version or enable image optimization."
msgstr "Substitua a imagem por uma versão menor, ou ative a otimização de imagens."

#: assets/js/packages/editor-audits/editor-audits.js:2283
#: assets/js/packages/editor-audits/editor-audits.strings.js:59
msgid "Large image files slow down the page."
msgstr "Arquivos de imagem grandes deixam a página mais lenta."

#: assets/js/packages/editor-audits/editor-audits.js:2282
#: assets/js/packages/editor-audits/editor-audits.strings.js:58
msgid "Oversized images"
msgstr "Imagens muito grandes"

#: assets/js/packages/editor-audits/editor-audits.js:2263
#: assets/js/packages/editor-audits/editor-audits.strings.js:57
msgid "Image is missing alt text."
msgstr "A imagem não tem texto alternativo."

#: assets/js/packages/editor-audits/editor-audits.js:2249
#: assets/js/packages/editor-audits/editor-audits.js:2291
#: assets/js/packages/editor-audits/editor-audits.strings.js:56
#: assets/js/packages/editor-audits/editor-audits.strings.js:61
msgid "No images"
msgstr "Nenhuma imagem"

#: assets/js/packages/editor-audits/editor-audits.js:2242
#: assets/js/packages/editor-audits/editor-audits.strings.js:55
msgid "Open the image's settings and add an Alt Text describing the image."
msgstr "Abra as configurações da imagem, e adicione um texto alternativo que descreva a imagem."

#: assets/js/packages/editor-audits/editor-audits.js:2241
#: assets/js/packages/editor-audits/editor-audits.strings.js:54
msgid "Every image needs a meaningful alt attribute for screen readers and image-search."
msgstr "Toda imagem precisa de um atributo “alt” significativo, tanto para leitores de tela, quanto para a pesquisa de imagens."

#: assets/js/packages/editor-audits/editor-audits.js:2215
#: assets/js/packages/editor-audits/editor-audits.strings.js:52
msgid "Element is hidden on all devices."
msgstr "O elemento está oculto em todos os dispositivos."

#: assets/js/packages/editor-audits/editor-audits.js:2200
#: assets/js/packages/editor-audits/editor-audits.strings.js:50
msgid "Remove the element or make it visible on at least one device breakpoint."
msgstr "Remova o elemento, ou torne ele visível em pelo menos um ponto de interrupção de dispositivo."

#: assets/js/packages/editor-audits/editor-audits.js:2199
#: assets/js/packages/editor-audits/editor-audits.strings.js:46
msgid "Elements hidden on all devices simultaneously are effectively dead code in the page tree."
msgstr "Elementos ocultos em todos os dispositivos simultaneamente são, na prática, código morto na árvore da página."

#: assets/js/packages/editor-audits/editor-audits.js:2181
#: assets/js/packages/editor-audits/editor-audits.strings.js:44
msgid "Heading level skipped."
msgstr "Nível de título ignorado."

#: assets/js/packages/editor-audits/editor-audits.js:2175
#: assets/js/packages/editor-audits/editor-audits.strings.js:43
msgid "More than one H1 on the page."
msgstr "Mais de um título H1 na página."

#: assets/js/packages/editor-audits/editor-audits.js:2169
#: assets/js/packages/editor-audits/editor-audits.strings.js:42
msgid "No H1 on the page."
msgstr "Nenhum título H1 na página."

#: assets/js/packages/editor-audits/editor-audits.js:2163
#: assets/js/packages/editor-audits/editor-audits.strings.js:41
msgid "No headings found on the page."
msgstr "Nenhum título encontrado na página."

#: assets/js/packages/editor-audits/editor-audits.js:2150
