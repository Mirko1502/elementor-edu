msgstr "O favicon do site não está definido."

#: assets/js/packages/editor-audits/editor-audits.js:2714
#: assets/js/packages/editor-audits/editor-audits.strings.js:133
msgid "Site logo is not set."
msgstr "O logo do site não está definido."

#: assets/js/packages/editor-audits/editor-audits.js:2708
#: assets/js/packages/editor-audits/editor-audits.strings.js:132
msgid "Site description is missing or still uses the default."
msgstr "A descrição do site está ausente, ou ainda usa o texto padrão."

#: assets/js/packages/editor-audits/editor-audits.js:2703
#: assets/js/packages/editor-audits/editor-audits.strings.js:131
msgid "Site name is missing or still uses the default."
msgstr "O nome do site está ausente, ou ainda usa o nome padrão."

#: assets/js/packages/editor-audits/editor-audits.js:2694
#: assets/js/packages/editor-audits/editor-audits.strings.js:130
msgid "Open Site Settings → Site Identity and complete all the missing fields."
msgstr "Abra Configurações do site → Identidade do site, e preencha todos os campos que estiverem ausentes."

#: assets/js/packages/editor-audits/editor-audits.js:2693
#: assets/js/packages/editor-audits/editor-audits.strings.js:126
msgid "Site name, description, logo, and favicon establish your brand and appear in search results and browser tabs."
msgstr "O nome, a descrição, o logo e o favicon do site definem sua identidade visual e aparecem nos resultados de pesquisa e nas abas do navegador."

#: assets/js/packages/editor-audits/editor-audits.js:2692
#: assets/js/packages/editor-audits/editor-audits.strings.js:125
msgid "Site identity"
msgstr "Identidade do site"

#: assets/js/packages/editor-audits/editor-audits.js:2678
#: assets/js/packages/editor-audits/editor-audits.strings.js:124
msgid "Column element"
msgstr "Elemento de coluna"

#: assets/js/packages/editor-audits/editor-audits.js:2678
#: assets/js/packages/editor-audits/editor-audits.strings.js:123
msgid "Section element"
msgstr "Elemento de seção"

#: assets/js/packages/editor-audits/editor-audits.js:2664
#: assets/js/packages/editor-audits/editor-audits.strings.js:121
msgid "Use the Container Converter to replace each section/column with a container."
msgstr "Use o conversor de contêineres para substituir cada seção/coluna por um contêiner."

#: assets/js/packages/editor-audits/editor-audits.js:2663
#: assets/js/packages/editor-audits/editor-audits.strings.js:117
msgid "Sections and columns are legacy elements. Containers render fewer DOM nodes and are more flexible."
msgstr "Seções e colunas são elementos obsoletos. Os contêineres geram menos nós do DOM e são mais flexíveis."

#: assets/js/packages/editor-audits/editor-audits.js:2662
#: assets/js/packages/editor-audits/editor-audits.strings.js:116
msgid "Sections and columns"
msgstr "Seções e colunas"

#: assets/js/packages/editor-audits/editor-audits.js:2651
#: assets/js/packages/editor-audits/editor-audits.strings.js:115
msgid "Search engines are discouraged from indexing this website."
msgstr "Os mecanismos de pesquisa são impedidos de indexar este site."

#: assets/js/packages/editor-audits/editor-audits.js:2641
#: assets/js/packages/editor-audits/editor-audits.strings.js:111
msgid "Go to Settings → Reading in the WordPress admin and uncheck \"Discourage search engines from indexing this site\" when the website should be indexed."
msgstr "Acesse Configurações → Leitura, no painel administrativo do WordPress, e desmarque a opção “Impedir que os mecanismos de pesquisa indexem este site” quando o site precisar ser indexado."

#: assets/js/packages/editor-audits/editor-audits.js:2640
#: assets/js/packages/editor-audits/editor-audits.strings.js:107
msgid "When search engine visibility is checked in WordPress Settings -> Reading -> Search Engine Visibility, search engines are discouraged from indexing the website."
msgstr "Quando a opção “Visibilidade nos mecanismos de pesquisa” estiver marcada em Configurações do WordPress -> Leitura -> Visibilidade nos mecanismos de pesquisa, os mecanismos de pesquisa são impedidos de indexar o site."

#: assets/js/packages/editor-audits/editor-audits.js:2639
#: assets/js/packages/editor-audits/editor-audits.strings.js:106
msgid "Search engine visibility"
msgstr "Visibilidade nos mecanismos de pesquisa"

#: assets/js/packages/editor-audits/editor-audits.js:2628
#: assets/js/packages/editor-audits/editor-audits.strings.js:105
msgid "No privacy policy page is set."
msgstr "Nenhuma página de política de privacidade foi definida."

#: assets/js/packages/editor-audits/editor-audits.js:2618
#: assets/js/packages/editor-audits/editor-audits.strings.js:101
msgid "Go to Settings > Privacy in the WordPress admin and assign a published privacy policy page."
msgstr "Acesse Configurações > Privacidade, no painel administrativo do WordPress, e atribua uma página publicada com a política de privacidade."

#: assets/js/packages/editor-audits/editor-audits.js:2617
#: assets/js/packages/editor-audits/editor-audits.strings.js:97
msgid "A privacy policy page is required by privacy regulations such as GDPR (EU) and CCPA (US)."
msgstr "É necessária uma página de política de privacidade, conforme exigido por regulamentações de privacidade como o GDPR (UE) e a CCPA (EUA)."

